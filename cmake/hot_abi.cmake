# Writes a hash of every hydra header, hot modules must match the executable
file(GLOB_RECURSE HEADERS "${SOURCE_DIR}/src/core/*.hpp" "${SOURCE_DIR}/src/core/*.h" "${SOURCE_DIR}/src/core/*.inc" "${SOURCE_DIR}/src/common/*.hpp")
list(SORT HEADERS)
set(ALL "")
foreach (HEADER ${HEADERS})
    file(SHA1 "${HEADER}" HASH)
    string(APPEND ALL "${HEADER}${HASH}")
endforeach ()
string(SHA1 ABI "${ALL}")
set(CONTENT "#pragma once\n#define HYDRA_HOT_ABI \"${ABI}\"\n")
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" OLD)
endif ()
if (NOT "${OLD}" STREQUAL "${CONTENT}")
    file(WRITE "${OUTPUT}" "${CONTENT}")
endif ()
